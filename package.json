{
  "name": "zed-text-tools-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/lsp/server.js --stdio",
    "test": "node --test test/*.test.js",
    "setup:example": "node scripts/setup-example.js",
    "build:server-dist": "node scripts/build-server-dist.js",
    "build:rust-notices": "node scripts/build-rust-notices.js extension/Cargo.toml extension/THIRD_PARTY_NOTICES && node scripts/build-rust-notices.js extension-proofreading/Cargo.toml extension-proofreading/THIRD_PARTY_NOTICES",
    "deploy:server-dev": "node scripts/deploy-server-dev.js",
    "patch:deps": "node scripts/patch-kuromoji.js",
    "postinstall": "npm run patch:deps",
    "pretest": "npm run patch:deps",
    "prestart": "npm run patch:deps"
  },
  "dependencies": {
    "@textlint/kernel": "15.8.0",
    "@textlint/module-interop": "15.8.0",
    "@textlint/textlint-plugin-text": "15.8.0",
    "jaconv": "1.1.2",
    "textlint-rule-preset-japanese": "10.0.4",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12",
    "kuromoji": "0.1.2"
  }
}
